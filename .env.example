# Copy to .env and fill in. .env is in .gitignore and never committed.

# Read by the Anthropic SDK.
ANTHROPIC_API_KEY=

# Use DeepSeek instead of Claude (its Anthropic-format API). Uncomment both lines.
# CODELENS_PROVIDER=deepseek
# DEEPSEEK_API_KEY=

# Optional overrides (defaults shown).
# CODELENS_QDRANT_URL=http://localhost:6333
# CODELENS_OLLAMA_URL=http://localhost:11434
# CODELENS_EMBEDDING_MODEL=nomic-embed-text
# CODELENS_CLAUDE_MODEL=claude-opus-5-5
# CODELENS_DEEPSEEK_MODEL=deepseek-flash
